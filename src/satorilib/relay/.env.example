# Required: the relay's Nostr public key (64 lowercase hex characters).
# Rewards are paid to the Base address of this key; keep its private key.
NOSTR_PUBKEY=

# Optional: Customize relay metadata
RELAY_NAME=Satori Relay
RELAY_DESCRIPTION=A Satori Network relay
RELAY_CONTACT=

# Optional: Port to expose the relay on (default: 7777)
RELAY_PORT=7777
